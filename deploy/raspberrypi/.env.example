# RadioTimer environment configuration (native / Raspberry Pi)
# Copy this file to .env next to it and adjust as needed.
# The systemd service reads it via EnvironmentFile.

# Where recordings are written. Use a mounted USB stick here if the
# SD card is small (the 2 GB card has very little free space after the OS).
RADIOTIMER_OUTPUT=/home/pi/recordings

# SQLite database path.
RADIOTIMER_DB=/home/pi/radiotimer/radiotimer.db

# Timezone for schedule display and cron evaluation.
RADIOTIMER_TZ=Europe/Berlin

# Optional: recording path pattern (mirrors the old VLC Timer layout).
# Default: <station>/<title>/<date> <HH-MM>.<ext>
# RADIOTIMER_PATTERN={station}/{title}/{date} {start_hm}.{ext}
